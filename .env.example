# Optional LLM provider settings.
# DashScope-compatible defaults are used when only the API key is provided.
MESSAGE_TALK_API_KEY=your_api_key_here
MESSAGE_TALK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MESSAGE_TALK_MODEL=qwen3.7-plus
MESSAGE_TALK_TIMEOUT=60
MESSAGE_TALK_AGENT_MAX_WORKERS=5
MESSAGE_TALK_DB_PATH=data/decision_records.db

# Optional RAG embedding and vector retrieval settings.
# local-hashing is a deterministic local fallback for development and tests.
# Use openai-compatible with a real embedding model for semantic dense retrieval.
# Qwen qwen3.7-text-embedding via DashScope-compatible API uses 1024 dimensions in live validation.
MESSAGE_TALK_EMBEDDING_PROVIDER=local-hashing
MESSAGE_TALK_EMBEDDING_MODEL=local-hashing-v1
MESSAGE_TALK_EMBEDDING_API_KEY=
MESSAGE_TALK_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MESSAGE_TALK_EMBEDDING_DIMENSIONS=128
MESSAGE_TALK_EMBEDDING_TIMEOUT=30
MESSAGE_TALK_EMBEDDING_BATCH_SIZE=8
MESSAGE_TALK_EMBEDDING_MAX_RETRIES=2
MESSAGE_TALK_VECTOR_STORE=sqlite
MESSAGE_TALK_VECTOR_DB_PATH=data/rag_vectors.db
MESSAGE_TALK_VECTOR_COLLECTION=tactical_knowledge
# Optional embedded Chroma backend:
# MESSAGE_TALK_VECTOR_STORE=chroma
# MESSAGE_TALK_CHROMA_MODE=persistent
# MESSAGE_TALK_VECTOR_DB_PATH=data/chroma_vectors
# Chroma Docker/HTTP profile (host connects to port 8001):
# MESSAGE_TALK_VECTOR_STORE=chroma
# MESSAGE_TALK_CHROMA_MODE=http
# MESSAGE_TALK_CHROMA_HOST=localhost
# MESSAGE_TALK_CHROMA_PORT=8001
# MESSAGE_TALK_CHROMA_SSL=false
# Optional Qwen semantic retrieval profile:
# MESSAGE_TALK_EMBEDDING_PROVIDER=openai-compatible
# MESSAGE_TALK_EMBEDDING_MODEL=qwen3.7-text-embedding
# MESSAGE_TALK_EMBEDDING_DIMENSIONS=1024
# MESSAGE_TALK_VECTOR_STORE=chroma
# MESSAGE_TALK_VECTOR_COLLECTION=tactical_knowledge_qwen_free
# MESSAGE_TALK_RAG_STRICT_EMBEDDING=true
MESSAGE_TALK_INGESTION_HISTORY_DB_PATH=data/rag_ingestion.db
MESSAGE_TALK_RAG_CHUNK_SIZE=900
MESSAGE_TALK_RAG_CHUNK_OVERLAP=120
MESSAGE_TALK_RAG_DENSE_ENABLED=true
MESSAGE_TALK_RAG_STRICT_EMBEDDING=false
MESSAGE_TALK_RAG_RRF_K=60
